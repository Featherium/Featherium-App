{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main shell webview only",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-open-service-instance",
    "allow-focus-service-instance",
    "allow-close-service-instance",
    "allow-resize-service-instance",
    "allow-debug-read-instance-marker",
    "allow-set-instance-user-agent",
    "allow-list-service-instances"
  ]
}
